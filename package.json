{
  "name": "chops-app",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:kill && turbo dev --filter=@chops/web --filter=@chops/api --filter=@chops/shared & cd apps/mobile && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo lint typecheck",
    "dev:web": "turbo dev --filter=@chops/web",
    "dev:api": "turbo dev --filter=@chops/api",
    "dev:mobile": "turbo dev --filter=@chops/mobile",
    "dev:kill": "lsof -ti :3000 | xargs kill -9 2>/dev/null; lsof -ti :4000 | xargs kill -9 2>/dev/null; echo 'Ports 3000 and 4000 cleared'",
    "test": "turbo test",
    "e2e": "pnpm e2e:browsers && pnpm e2e:up && pnpm e2e:migrate && pnpm --filter @chops/e2e e2e",
    "e2e:browsers": "pnpm --filter @chops/e2e exec playwright install chromium",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:migrate": "cd apps/api && DATABASE_URL='postgresql://chops:chops@localhost:5433/chops_e2e?schema=public' pnpm exec prisma migrate deploy"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "turbo": "^2.8.8",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "^19.1.0",
      "@tamagui/core": "2.0.0-rc.14",
      "@tamagui/lucide-icons": "2.0.0-rc.14",
      "@tamagui/helpers-icon": "2.0.0-rc.14",
      "@tamagui/sizable-context": "2.0.0-rc.14"
    }
  }
}
