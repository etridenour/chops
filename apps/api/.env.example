# Database
DATABASE_URL="postgresql://user:password@localhost:5432/chops?schema=public"

# Server
API_PORT=4000
WEB_URL=http://localhost:3000

# JWT
JWT_SECRET=your-secret-here-generate-with-openssl-rand-hex-32

# Email (Gmail SMTP — requires App Password)
# 1. Enable 2FA on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Email transport (optional — defaults to Gmail when unset).
# Point these at a local catcher like Mailpit to avoid sending real mail:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=chops@example.test
